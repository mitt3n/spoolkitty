# Spoolman Kitty configuration. Copy this to .env, fill in your values, then:
#   docker compose up -d --build

# How the container reaches Spoolman. If Spoolman is in this same compose
# project use http://spoolman:8000; otherwise use the server's LAN address.
SPOOLMAN_URL=http://spoolman:8000

# What goes inside the QR code (the address your phone can open).
PUBLIC_SPOOLMAN_URL=http://spoolman:8000

# url | spoolman  (spoolman = web+spoolman:s-<id>)
QR_MODE=url

# Print darkness 0-65535; lower if stickers smear.
ENERGY=65535

# 8 px per mm -> 30 mm sticker
LABEL_HEIGHT_PX=240

# Blank rows fed after each label
FEED_PX=90

# How often Spoolman is checked, in seconds
POLL_SECONDS=5

TZ=UTC
